# Vite only reads .env.production (not .env.development) when you run
# `npm run build`. Copy this file to .env.production and fill in the real
# deployed backend URL before building for anywhere but localhost —
# otherwise the built app has no API base URL and every request breaks.
#
#   cp .env.production.example .env.production

VITE_API_BASE_URL=https://your-backend-domain.example/api
